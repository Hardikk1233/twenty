{
  "name": "twenty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Twenty: a 30-day finance course for an AI engineer. Installable, offline, no login.",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
